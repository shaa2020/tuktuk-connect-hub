# Copy to .env (never commit real values). Server-only variables must be set as secrets in the
# hosting provider, NOT prefixed with VITE_ (VITE_ variables are shipped to every browser).

# --- Supabase (public: URL + publishable/anon key are safe in browsers) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase service role (SERVER SECRET — bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential encryption (SERVER SECRET; 32+ random bytes, e.g. `openssl rand -base64 48`).
# Changing it makes every stored integration credential unreadable — rotate only with a re-encrypt script.
CREDENTIALS_ENCRYPTION_KEY=

# --- Operator-owned integrations (TukTuk24 workspace only; SERVER SECRETS) ---
LOVABLE_API_KEY=          # Lovable AI gateway + connector gateway
WHATSAPP_API_KEY=         # Lovable WhatsApp connector (also verifies its webhooks)
GOOGLE_MAIL_API_KEY=      # Lovable Gmail connector
WEBSITE_API_KEY=          # tuktuk24lisbon.com /api/v1

# --- Web push (SERVER SECRET; the public key is in src/lib/push.ts) ---
VAPID_PRIVATE_KEY=

# --- Lovable cron auth helper (only if Lovable cron routes are used) ---
LOVABLE_CRON_SECRET=

# --- Feature flags (public) ---
# Turn on only after enabling "Allow new users to sign up" in Supabase Auth (docs/BLOCKERS.md B-AUTH-1)
VITE_PUBLIC_SIGNUP=false
